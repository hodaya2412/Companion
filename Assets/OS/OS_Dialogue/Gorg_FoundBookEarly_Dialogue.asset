  m_Script: {fileID: 11500000, guid: 95847929271290341bb73bbda3eeeffc, type: 3}
  m_Name: Gorg_FoundBookEarly_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueId: 
  lines:
  - speaker: Goerge
    text: Oh! You found my book! Thank you. Do you need help with something?
    portrait: {fileID: 0}
  - speaker: Ran
    text: Yes, I'm looking for a golden key. Do you know where I might find it?
    portrait: {fileID: 0}
  - speaker: Goerge
    text: Deep within the forest, there is a dragon. Rumor has it that he guards
      a magical golden key there.
    portrait: {fileID: 0}
  - speaker: Goerge
    text: "But be careful\u2026 every person who has gone there has never returned."
    portrait: {fileID: 0}
