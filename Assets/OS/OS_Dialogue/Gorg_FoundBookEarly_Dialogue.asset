  m_Script: {fileID: 11500000, guid: 95847929271290341bb73bbda3eeeffc, type: 3}
  m_Name: Gorg_FoundBookEarly_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueId: 
  lines:
  - speaker: Goerge
    text: "Well I\u2019ll be damned... That\u2019s my book"
    portrait: {fileID: 21300000, guid: 3e0e79d6f6f9965418cecb47f544043c, type: 3}
  - speaker: Ran
    text: Found it in a cave.
    portrait: {fileID: 21300000, guid: fac10aea3c7ad4f47ad6a5085edd602f, type: 3}
  - speaker: Goerge
    text: "Yeah, that\u2019s where my problems usually end up."
    portrait: {fileID: 21300000, guid: b645c392f48b61140a06d56869784554, type: 3}
  - speaker: Ran
    text: "I\u2019m actually looking for a Golden Key."
    portrait: {fileID: 21300000, guid: 291ae8d5c5a7512459f5b5e13e0be914, type: 3}
  - speaker: George
    text: "Of course you are. It\u2019s on a dragon\u2019s neck."
    portrait: {fileID: 21300000, guid: d34783ae0c34f8e43ab3a7d14dcda8f4, type: 3}
  - speaker: Ren
    text: A dragon....?
    portrait: {fileID: 21300000, guid: b885994ca6d252f4fa9f8995e5bea62d, type: 3}
  - speaker: George
    text: "Burned cities for fun. They couldn\u2019t kill it  so they locked it behind
      a magic barrier, i'll give you this sword it breaks the barrier."
    portrait: {fileID: 21300000, guid: d34783ae0c34f8e43ab3a7d14dcda8f4, type: 3}
  - speaker: Ren
    text: Why give it to me?
    portrait: {fileID: 21300000, guid: 291ae8d5c5a7512459f5b5e13e0be914, type: 3}
  - speaker: George
    text: 'You brought my book back without being asked.

      That counts.'
    portrait: {fileID: 21300000, guid: d34783ae0c34f8e43ab3a7d14dcda8f4, type: 3}
  - speaker: Ren
    text: Thanks old men!
    portrait: {fileID: 21300000, guid: fac10aea3c7ad4f47ad6a5085edd602f, type: 3}
  - speaker: George
    text: "Don\u2019t.\nYou still have to meet the dragon."
    portrait: {fileID: 21300000, guid: d34783ae0c34f8e43ab3a7d14dcda8f4, type: 3}
  endActions:
